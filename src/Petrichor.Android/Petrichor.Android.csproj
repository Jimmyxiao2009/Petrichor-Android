<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType><RootNamespace>Petrichor.Mobile</RootNamespace>
    <UseMaui>true</UseMaui><UseMaterial3>true</UseMaterial3><SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <ApplicationTitle>Petrichor</ApplicationTitle><ApplicationId>app.petrichor.music</ApplicationId>
    <ApplicationDisplayVersion>1.0.10</ApplicationDisplayVersion><ApplicationVersion>11</ApplicationVersion>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk><AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <AndroidLinkMode Condition="'$(Configuration)' == 'Release'">SdkOnly</AndroidLinkMode>
    <PublishTrimmed Condition="'$(Configuration)' == 'Release'">true</PublishTrimmed>
    <TrimMode Condition="'$(Configuration)' == 'Release'">partial</TrimMode>
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
    <AndroidEnableProfiledAot Condition="'$(Configuration)' == 'Release'">true</AndroidEnableProfiledAot>
    <!-- .NET Android release JNI registration workaround: dotnet/maui#35209. -->
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <NoWarn>$(NoWarn);CA1422</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep convention-based JSON model members used by the shared API client. -->
    <TrimmerRootAssembly Include="Petrichor.Core" />
    <MauiIcon Include="Resources/AppIcon/appicon.png" />
    <MauiSplashScreen Include="Resources/Splash/splash.png" Color="#FFFBFC" BaseSize="96,96" />
    <MauiImage Include="Resources/Images/*" /><MauiFont Include="Resources/Fonts/*" />
    <MauiAsset Include="Resources/Raw/**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <PackageReference Include="QRCoder" Version="1.7.0" />
    <ProjectReference Include="../Petrichor.Core/Petrichor.Core.csproj" />
  </ItemGroup>
</Project>
